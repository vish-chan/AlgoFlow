FROM node:22-alpine AS build

WORKDIR /app

# Install from the workspace root so @algoflow/visualizer resolves.
# Manifests first, so the install layer caches independently of source changes.
COPY package.json package-lock.json ./
COPY apps/web/frontend/package.json apps/web/frontend/
COPY packages/shared/visualizer/package.json packages/shared/visualizer/
RUN npm ci

COPY packages/shared/visualizer/ packages/shared/visualizer/
COPY apps/web/frontend/ apps/web/frontend/

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build -w algo-frontend

# Serve
FROM nginx:alpine

COPY --from=build /app/apps/web/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
